DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Set to 1 only if verified TLS to Neon fails in your environment
# DATABASE_SSL_INSECURE=1

# Auth.js — required in production
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Canonical site origin (prevents host-header poisoning with trustHost)
AUTH_URL="https://your-domain.com"

# Create admins with the CLI (not env):
#   npm run admin:create -- --email you@example.com --password 'StrongPass!' --name "Ops Admin"
